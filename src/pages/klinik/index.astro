---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { rupiah, wa } from '../../lib/util';
import { icons, services, reasons, doctors, schedule, testimonials, faqs } from '../../data/klinik';

const nav = [
  ['Layanan', '#layanan'],
  ['Dokter', '#dokter'],
  ['Jadwal', '#jadwal'],
  ['Lokasi', '#lokasi'],
  ['FAQ', '#faq'],
];
const waHello = wa('Halo Klinik Gigi Arunika, saya ingin bertanya tentang jadwal dan layanan.');
---

<Base
  title="Klinik Gigi Arunika — Dokter Gigi Keluarga di Bandung"
  description="Klinik gigi keluarga di Bandung: scaling, tambal, behel, gigi anak. Buka sampai malam dan akhir pekan."
  bodyClass="bg-white font-sans text-slate-600"
  themeColor="#0d9488"
>
  <!-- Top info bar -->
  <div class="bg-teal-700 text-teal-50">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-5 py-2 text-xs">
      <span>Sen–Jum 09.00–21.00 · Sab–Min 09.00–17.00</span>
      <span class="hidden sm:inline">Jl. Kenanga Raya No. 12, Bandung</span>
    </div>
  </div>

  <!-- Header -->
  <header class="sticky top-0 z-40 border-b border-slate-100 bg-white/90 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
      <a href="#" class="flex items-center gap-2.5">
        <svg viewBox="0 0 32 32" class="h-9 w-9" aria-hidden="true">
          <rect width="32" height="32" rx="10" fill="#0d9488" />
          <path d="M11 9c-2 0-3.5 1.6-3.5 4 0 3.5 1.6 10 3.3 10 1.4 0 1.5-4.5 5.2-4.5s3.8 4.5 5.2 4.5c1.7 0 3.3-6.5 3.3-10 0-2.4-1.5-4-3.5-4-1.8 0-2.8 1-5 1s-3.2-1-5-1z" fill="#fff" />
        </svg>
        <span class="leading-tight">
          <span class="block text-base font-bold text-slate-900">Arunika</span>
          <span class="block text-[11px] tracking-wide text-teal-700 uppercase">Klinik Gigi Keluarga</span>
        </span>
      </a>
      <nav class="hidden items-center gap-7 text-sm font-medium text-slate-600 md:flex">
        {nav.map(([label, href]) => <a href={href} class="hover:text-teal-700">{label}</a>)}
      </nav>
      <a href="#janji" class="rounded-full bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-teal-700">
        Buat Janji
      </a>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden bg-gradient-to-b from-teal-50 to-white">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-16 md:grid-cols-2 md:py-24">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-xs font-semibold text-teal-700 shadow-sm ring-1 ring-teal-100">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span> Buka hari ini sampai 21.00
          </span>
          <h1 class="mt-5 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
            Senyum sehat untuk <span class="text-teal-600">seluruh keluarga</span>
          </h1>
          <p class="mt-5 max-w-lg text-lg leading-relaxed">
            Dokter gigi umum dan spesialis dalam satu klinik. Harga dijelaskan di awal, alat steril, dan jadwal
            yang pas untuk orang kantoran.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#janji" class="rounded-full bg-teal-600 px-6 py-3 font-semibold text-white shadow-lg shadow-teal-600/20 hover:bg-teal-700">
              Buat Janji Temu
            </a>
            <a href="#layanan" class="rounded-full bg-white px-6 py-3 font-semibold text-slate-800 ring-1 ring-slate-200 hover:ring-teal-300">
              Lihat Layanan & Harga
            </a>
          </div>
          <dl class="mt-10 grid max-w-md grid-cols-3 gap-4 text-center">
            <div><dt class="text-2xl font-bold text-slate-900">12+</dt><dd class="text-xs">tahun berdiri</dd></div>
            <div><dt class="text-2xl font-bold text-slate-900">4</dt><dd class="text-xs">dokter & spesialis</dd></div>
            <div><dt class="text-2xl font-bold text-slate-900">4,9★</dt><dd class="text-xs">ulasan pasien</dd></div>
          </dl>
        </div>

        <!-- Illustration card -->
        <div class="relative mx-auto w-full max-w-md">
          <div class="absolute -top-6 -right-6 h-40 w-40 rounded-full bg-cyan-200/60 blur-2xl"></div>
          <div class="absolute -bottom-8 -left-8 h-40 w-40 rounded-full bg-teal-200/60 blur-2xl"></div>
          <div class="relative rounded-3xl bg-gradient-to-br from-teal-500 to-cyan-600 p-8 shadow-2xl">
            <svg viewBox="0 0 200 160" class="w-full" aria-hidden="true">
              <circle cx="100" cy="80" r="70" fill="#fff" opacity=".12" />
              <path d="M70 40c-14 0-24 11-24 28 0 24 11 68 23 68 10 0 10-31 31-31s21 31 31 31c12 0 23-44 23-68 0-17-10-28-24-28-12 0-19 7-30 7s-18-7-30-7z" fill="#fff" />
              <path d="M78 58c-6 0-10 5-10 12" stroke="#99f6e4" stroke-width="5" stroke-linecap="round" fill="none" />
              <path d="M150 30l4 9 9 4-9 4-4 9-4-9-9-4 9-4z" fill="#fef08a" />
              <path d="M40 110l3 6 6 3-6 3-3 6-3-6-6-3 6-3z" fill="#fef08a" />
            </svg>
            <div class="mt-4 rounded-2xl bg-white p-4 shadow-lg">
              <p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">Praktik hari ini</p>
              <div class="mt-3 space-y-2.5">
                <div class="flex items-center justify-between text-sm"><span class="font-medium text-slate-800">drg. Anindya Putri</span><span class="rounded-full bg-emerald-50 px-2 py-0.5 text-xs text-emerald-700">Tersedia</span></div>
                <div class="flex items-center justify-between text-sm"><span class="font-medium text-slate-800">drg. Citra Lestari, Sp.KGA</span><span class="rounded-full bg-amber-50 px-2 py-0.5 text-xs text-amber-700">2 slot lagi</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section id="layanan" class="mx-auto max-w-6xl px-5 py-20">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold tracking-widest text-teal-600 uppercase">Layanan & Harga</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">Perawatan lengkap, harga terbuka</h2>
        <p class="mt-3">Harga di bawah adalah harga mulai. Biaya pasti disampaikan setelah pemeriksaan, sebelum tindakan.</p>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((s) => (
            <article class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-teal-200 hover:shadow-md">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-50 text-teal-600 group-hover:bg-teal-600 group-hover:text-white">
                <Icon d={icons[s.icon]} />
              </div>
              <h3 class="mt-4 font-semibold text-slate-900">{s.name}</h3>
              <p class="mt-1.5 text-sm leading-relaxed">{s.desc}</p>
              <p class="mt-4 text-sm">
                mulai <span class="font-semibold text-slate-900">{rupiah(s.price)}</span>
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Why us -->
    <section class="bg-slate-900 text-slate-300">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 lg:grid-cols-3">
        <div>
          <p class="text-sm font-semibold tracking-widest text-teal-400 uppercase">Kenapa Arunika</p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-white">Ke dokter gigi tanpa was-was</h2>
          <p class="mt-3">Kami tahu banyak orang menunda ke dokter gigi karena takut sakit atau takut biaya. Ini yang kami lakukan.</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:col-span-2">
          {
            reasons.map((r) => (
              <div class="rounded-2xl bg-white/5 p-6 ring-1 ring-white/10">
                <Icon d={icons[r.icon]} class="h-7 w-7 text-teal-400" />
                <h3 class="mt-4 font-semibold text-white">{r.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed">{r.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Doctors -->
    <section id="dokter" class="mx-auto max-w-6xl px-5 py-20">
      <p class="text-sm font-semibold tracking-widest text-teal-600 uppercase">Tim Dokter</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">Dokter umum dan spesialis</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          doctors.map((d) => (
            <article class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
              <div class={`flex h-44 items-end justify-center bg-gradient-to-br ${d.tone}`}>
                <svg viewBox="0 0 120 100" class="h-36" aria-hidden="true">
                  <circle cx="60" cy="38" r="22" fill="#fff" opacity=".95" />
                  <path d="M18 100c4-26 20-36 42-36s38 10 42 36z" fill="#fff" opacity=".95" />
                  <text x="60" y="45" text-anchor="middle" font-size="16" font-weight="700" fill="#0f766e" font-family="Inter Variable, sans-serif">{d.initials}</text>
                </svg>
              </div>
              <div class="p-5">
                <h3 class="font-semibold text-slate-900">{d.name}</h3>
                <p class="mt-1 text-sm">{d.role}</p>
                <p class="mt-3 inline-flex rounded-full bg-slate-50 px-2.5 py-1 text-xs text-slate-500 ring-1 ring-slate-100">Praktik: {d.days}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Schedule + testimonials -->
    <section id="jadwal" class="bg-teal-50/60">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 lg:grid-cols-5">
        <div class="lg:col-span-3">
          <p class="text-sm font-semibold tracking-widest text-teal-600 uppercase">Jadwal Praktik</p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">Buka 7 hari seminggu</h2>
          <div class="mt-8 overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-100">
            <table class="w-full text-left text-sm">
              <thead class="bg-slate-50 text-xs tracking-wide text-slate-500 uppercase">
                <tr><th class="px-5 py-3">Hari</th><th class="px-5 py-3">Jam</th><th class="hidden px-5 py-3 sm:table-cell">Dokter</th></tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {
                  schedule.map(([day, hours, docs]) => (
                    <tr>
                      <td class="px-5 py-3 font-medium text-slate-900">{day}</td>
                      <td class="px-5 py-3">{hours}</td>
                      <td class="hidden px-5 py-3 sm:table-cell">{docs}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
        <div class="space-y-4 lg:col-span-2">
          <p class="text-sm font-semibold tracking-widest text-teal-600 uppercase">Kata Pasien</p>
          {
            testimonials.map((t) => (
              <figure class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-100">
                <div class="text-amber-400" aria-label="5 bintang">★★★★★</div>
                <blockquote class="mt-2 text-sm leading-relaxed text-slate-700">“{t.text}”</blockquote>
                <figcaption class="mt-3 text-xs text-slate-500">
                  <span class="font-semibold text-slate-800">{t.name}</span> · {t.service}
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Booking + location -->
    <section id="janji" class="mx-auto max-w-6xl px-5 py-20">
      <div class="grid gap-10 lg:grid-cols-2">
        <div class="rounded-3xl bg-white p-7 shadow-xl ring-1 ring-slate-100 sm:p-9">
          <p class="text-sm font-semibold tracking-widest text-teal-600 uppercase">Buat Janji Temu</p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900">Isi form, admin konfirmasi via WhatsApp</h2>
          <form id="booking" class="mt-7 grid gap-4 sm:grid-cols-2">
            <label class="text-sm font-medium text-slate-700 sm:col-span-2">Nama lengkap
              <input name="nama" required class="mt-1.5 w-full rounded-xl border border-slate-200 px-4 py-2.5 font-normal outline-none focus:border-teal-500 focus:ring-4 focus:ring-teal-100" />
            </label>
            <label class="text-sm font-medium text-slate-700">Layanan
              <select name="layanan" class="mt-1.5 w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 font-normal outline-none focus:border-teal-500 focus:ring-4 focus:ring-teal-100">
                {services.map((s) => <option>{s.name}</option>)}
              </select>
            </label>
            <label class="text-sm font-medium text-slate-700">Tanggal
              <input type="date" name="tanggal" required class="mt-1.5 w-full rounded-xl border border-slate-200 px-4 py-2.5 font-normal outline-none focus:border-teal-500 focus:ring-4 focus:ring-teal-100" />
            </label>
            <label class="text-sm font-medium text-slate-700 sm:col-span-2">Dokter (opsional)
              <select name="dokter" class="mt-1.5 w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 font-normal outline-none focus:border-teal-500 focus:ring-4 focus:ring-teal-100">
                <option>Siapa saja yang tersedia</option>
                {doctors.map((d) => <option>{d.name}</option>)}
              </select>
            </label>
            <label class="text-sm font-medium text-slate-700 sm:col-span-2">Keluhan singkat
              <textarea name="keluhan" rows="3" class="mt-1.5 w-full rounded-xl border border-slate-200 px-4 py-2.5 font-normal outline-none focus:border-teal-500 focus:ring-4 focus:ring-teal-100" placeholder="Contoh: gigi geraham kiri ngilu saat minum dingin"></textarea>
            </label>
            <button class="rounded-full bg-teal-600 px-6 py-3 font-semibold text-white hover:bg-teal-700 sm:col-span-2">
              Kirim via WhatsApp
            </button>
            <p class="text-xs text-slate-400 sm:col-span-2">Demo: pesan dibuka di WhatsApp Anda dan Anda memilih kontak tujuan. Di situs klien, nomor klinik sudah terisi.</p>
          </form>
        </div>

        <div id="lokasi">
          <p class="text-sm font-semibold tracking-widest text-teal-600 uppercase">Lokasi</p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900">Mudah dijangkau dari pusat kota</h2>
          <div class="mt-6 overflow-hidden rounded-3xl ring-1 ring-slate-200">
            <svg viewBox="0 0 400 220" class="w-full bg-slate-100" role="img" aria-label="Peta ilustrasi lokasi klinik">
              <rect width="400" height="220" fill="#f1f5f9" />
              <path d="M0 150h400M120 0v220M280 0v220M0 60h400" stroke="#fff" stroke-width="14" />
              <path d="M0 150h400M120 0v220" stroke="#fde68a" stroke-width="6" />
              <rect x="140" y="80" width="60" height="50" rx="6" fill="#e2e8f0" />
              <rect x="300" y="80" width="70" height="50" rx="6" fill="#e2e8f0" />
              <rect x="20" y="80" width="80" height="50" rx="6" fill="#dcfce7" />
              <rect x="210" y="166" width="55" height="40" rx="6" fill="#e2e8f0" />
              <g transform="translate(222 70)">
                <path d="M18 0C8 0 0 8 0 18c0 13 18 32 18 32s18-19 18-32C36 8 28 0 18 0z" fill="#0d9488" />
                <circle cx="18" cy="18" r="7" fill="#fff" />
              </g>
            </svg>
          </div>
          <ul class="mt-6 space-y-3 text-sm">
            <li><span class="font-semibold text-slate-900">Alamat:</span> Jl. Kenanga Raya No. 12, Bandung (contoh)</li>
            <li><span class="font-semibold text-slate-900">Parkir:</span> 8 mobil, motor di depan klinik</li>
            <li><span class="font-semibold text-slate-900">Pembayaran:</span> Tunai, debit/kredit, QRIS, asuransi rekanan</li>
          </ul>
          <p class="mt-4 text-xs text-slate-400">Di situs klien, ilustrasi ini diganti embed Google Maps dan tautan Google Business Profile.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="bg-slate-50">
      <div class="mx-auto max-w-3xl px-5 py-20">
        <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900">Pertanyaan yang sering diajukan</h2>
        <div class="mt-10 space-y-3">
          {
            faqs.map(([q, a]) => (
              <details class="group rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-100">
                <summary class="flex items-center justify-between font-semibold text-slate-900">
                  {q}
                  <span class="ml-4 text-teal-600 transition group-open:rotate-45">+</span>
                </summary>
                <p class="mt-3 text-sm leading-relaxed">{a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-slate-900 text-sm text-slate-400">
    <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-10 sm:flex-row sm:items-center sm:justify-between">
      <p><span class="font-semibold text-white">Klinik Gigi Arunika</span> · Jl. Kenanga Raya No. 12, Bandung</p>
      <p>© 2026 · Situs demo, bisnis fiktif</p>
    </div>
  </footer>

  <!-- Floating WhatsApp button -->
  <a href={waHello} target="_blank" rel="noopener" class="fixed right-5 bottom-5 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-xl hover:scale-105" aria-label="Chat WhatsApp">
    <svg viewBox="0 0 24 24" class="h-7 w-7" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 18a8 8 0 01-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1112 20zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8.9c-.1.2-.3.2-.5.1a6.6 6.6 0 01-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 00-.6.3 2.7 2.7 0 00-.9 2 4.7 4.7 0 001 2.5 10.8 10.8 0 004.2 3.7c1.6.7 2.2.7 3 .6a2.5 2.5 0 001.7-1.2 2 2 0 00.1-1.2c0-.1-.2-.2-.4-.3z" /></svg>
  </a>
</Base>

<script>
  const form = document.getElementById('booking') as HTMLFormElement;
  const date = form.querySelector<HTMLInputElement>('input[name=tanggal]')!;
  date.min = new Date().toISOString().slice(0, 10);

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const tgl = new Date(String(f.get('tanggal'))).toLocaleDateString('id-ID', {
      weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
    });
    const lines = [
      'Halo Klinik Gigi Arunika, saya ingin membuat janji temu.',
      '',
      `Nama: ${f.get('nama')}`,
      `Layanan: ${f.get('layanan')}`,
      `Tanggal: ${tgl}`,
      `Dokter: ${f.get('dokter')}`,
    ];
    const keluhan = String(f.get('keluhan') || '').trim();
    if (keluhan) lines.push(`Keluhan: ${keluhan}`);
    window.open(`https://wa.me/?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
  });
</script>
