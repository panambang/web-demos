  }

  /* Kitchen day carousel */
  .ps-day { border-bottom: var(--line) solid var(--ink); }
  .ps-track {
    display: flex; gap: 1.5rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    padding: 1.5rem max(1rem, calc((100vw - 80rem) / 2 + 1.5rem)) 1.75rem; scroll-padding-inline: max(1rem, calc((100vw - 80rem) / 2 + 1.5rem));
    cursor: grab; overscroll-behavior-x: contain;
  }
