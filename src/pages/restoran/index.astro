  .ps-track.is-drag { cursor: grabbing; scroll-snap-type: none; user-select: none; }
  .ps-card {
    flex: 0 0 min(82vw, 21.5rem); scroll-snap-align: start; border: var(--line) solid var(--ink); border-radius: 1.25rem;
    padding: 1rem 1rem 1.4rem; box-shadow: 6px 6px 0 var(--ink); transform: rotate(var(--r)); transition: transform 0.35s ease;
  }
  .ps-card:hover { transform: rotate(0) translateY(-6px); }
  .ps-card.bg-\[\#d9481e\], .ps-card.bg-\[\#2f6b3a\] { color: #fff8ec; }
  .ps-sticker { background: #fff; padding: 0.5rem; border-radius: 0.4rem; transform: rotate(calc(var(--r) * -1.6)); box-shadow: 0 10px 20px -10px rgb(0 0 0 / 0.6); }
  .ps-sticker img { border-radius: 0.2rem; }
  .ps-bar { height: 100%; width: 100%; background: var(--ink); border-radius: 999px; transform-origin: left; transform: scaleX(0.25); transition: transform 0.15s linear; }

  /* Board */
  .ps-board-sec { border-bottom: var(--line) solid var(--ink); }
  .ps-cork {
    position: relative; border: var(--line) solid var(--ink); border-radius: 1rem; padding: 2.25rem 1.25rem;
    background-color: #c9a273;
    background-image: radial-gradient(rgb(90 55 25 / 0.28) 1px, transparent 1.6px), radial-gradient(rgb(255 240 210 / 0.25) 1px, transparent 1.6px);
    background-size: 9px 9px, 13px 13px; background-position: 0 0, 4px 6px;
    box-shadow: inset 0 0 0 12px #7a4a26, inset 0 0 0 15px var(--ink), 8px 8px 0 var(--ink);
  }
  @media (min-width: 640px) { .ps-cork { padding: 3rem 2.75rem; } }
  .ps-notes { display: grid; gap: 1.75rem 1.75rem; grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 640px) { .ps-notes { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .ps-notes { grid-template-columns: repeat(3, 1fr); gap: 2.25rem 2.5rem; } }
  .ps-pnote {
    position: relative; padding: 1.4rem 1.25rem 1.2rem; border-radius: 3px; background: #fffdf7;
    box-shadow: 0 14px 22px -12px rgb(0 0 0 / 0.55); transform: rotate(var(--r)); transition: transform 0.3s ease, box-shadow 0.3s;
  }
  .js .ps-pnote[data-reveal] { transform: rotate(var(--r)) translateY(18px); }
  .js .ps-pnote[data-reveal].is-in, .ps-pnote:hover { transform: rotate(var(--r)); }
  .ps-pnote:hover { transform: rotate(0) translateY(-4px) scale(1.02) !important; box-shadow: 0 22px 28px -14px rgb(0 0 0 / 0.6); z-index: 2; }
  .ps-pnote.is-info { background: #ffe58a; }
  .ps-pnote.is-review::before {
    content: ''; position: absolute; top: -0.7rem; left: 50%; width: 5.5rem; height: 1.5rem; translate: -50% 0; rotate: -4deg;
    background: rgb(255 255 255 / 0.55); border: 1px solid rgb(0 0 0 / 0.08);
  }
  .ps-pnote.is-info::before {
    content: ''; position: absolute; top: 0.55rem; left: 50%; width: 1rem; height: 1rem; translate: -50% 0; border-radius: 999px;
    background: radial-gradient(circle at 35% 35%, #ff8a6a, var(--cabai) 60%, #7a1c06); box-shadow: 0 3px 4px rgb(0 0 0 / 0.4);
  }
  .ps-pnote.is-info { padding-top: 2rem; }

  /* Reservation */
  .ps-resv { border-bottom: var(--line) solid var(--ink); }
  .ps-resv > div:first-child { border-bottom: var(--line) solid var(--ink); }
  @media (min-width: 1024px) { .ps-resv > div:first-child { border-bottom: 0; border-right: var(--line) solid var(--ink); } }
  .ps-sticky-note {
    position: absolute; left: 1.25rem; bottom: 1.25rem; max-width: 17rem; padding: 1rem 1.1rem;
    background: #ffe58a; box-shadow: 0 14px 24px -10px rgb(0 0 0 / 0.6); transform: rotate(-2.5deg);
  }
  @media (min-width: 640px) { .ps-sticky-note { left: 2rem; bottom: 2rem; } }
  .ps-field { display: grid; gap: 0.35rem; min-width: 0; border: 0; padding: 0; margin: 0; }
  .ps-field > span, .ps-field > legend { font-size: 0.8rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; }
  .ps-field input, .ps-field select, .ps-field textarea {
    width: 100%; border: 2px solid var(--ink); border-radius: 0.7rem; background: #fffdf7; padding: 0.7rem 0.85rem;
    font: inherit; font-size: 1rem; color: var(--ink); transition: box-shadow 0.15s;
  }
  .ps-field input:focus, .ps-field select:focus, .ps-field textarea:focus { outline: none; box-shadow: 4px 4px 0 var(--kunyit), 0 0 0 1px var(--ink); }
  .ps-field [aria-invalid='true'] { border-color: var(--cabai); background: #fff1ec; }
  .ps-stepper { display: flex; align-items: stretch; border: 2px solid var(--ink); border-radius: 0.7rem; background: #fffdf7; overflow: hidden; }
  .ps-stepper button { width: 3rem; display: grid; place-items: center; transition: background-color 0.15s; }
  .ps-stepper button:hover { background: var(--kunyit); }
  .ps-stepper input { border: 0 !important; border-radius: 0 !important; text-align: center; font-weight: 800; box-shadow: none !important; -moz-appearance: textfield; appearance: textfield; }
  .ps-stepper input::-webkit-inner-spin-button { display: none; }
  .ps-area {
    display: block; cursor: pointer; border: 2px solid var(--ink); border-radius: 0.8rem; padding: 0.65rem 0.85rem;
    background: #fffdf7; transition: background-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .ps-area:hover { transform: translateY(-1px); }
  .ps-area:has(input:checked) { background: var(--kunyit); box-shadow: 3px 3px 0 var(--ink); }
  .ps-area:has(input:focus-visible) { outline: 3px solid var(--cabai); outline-offset: 2px; }
  .ps-area-sm { padding: 0.55rem 0.4rem; text-align: center; }
  .ps-error { color: var(--cabai); font-weight: 800; font-size: 0.9rem; }

  /* Footer */
  .ps-footer { background: var(--paper); }
  .ps-branch { border: var(--line) solid var(--ink); border-radius: 1rem; padding: 1rem 1.1rem 1.2rem; background: #fff; box-shadow: 5px 5px 0 var(--ink); max-width: 24rem; }
  .ps-hour { display: flex; justify-content: space-between; gap: 1rem; padding: 0.4rem 0.6rem; border-radius: 0.5rem; font-weight: 600; }
  .ps-hour.is-today { background: var(--kunyit); font-weight: 800; box-shadow: inset 0 0 0 2px var(--ink); }
  .ps-contact {
    display: flex; flex-direction: column; gap: 0.5rem; border: var(--line) solid var(--ink); border-radius: 1rem; padding: 0.9rem 1rem 0;
    overflow: hidden; background: #fff; transition: transform 0.15s, box-shadow 0.15s;
  }
  .ps-contact:hover { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 var(--ink); }
  .ps-contact-cta { display: flex; align-items: center; gap: 0.5rem; margin: 0 -1rem; padding: 0.55rem 1rem; background: var(--ink); color: var(--paper); font-size: 0.85rem; font-weight: 800; }
  .js .ps-drawing path { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 2.2s ease; }
  .js .ps-drawing text { opacity: 0; transition: opacity 0.6s ease 1.6s; }
  .js .ps-drawing.is-in path { stroke-dashoffset: 0; }
  .js .ps-drawing.is-in text { opacity: 1; }

  /* Dock, toast, drawer */
  .ps-dock {
    position: fixed; inset: auto 0 0; z-index: 45; display: grid; grid-template-columns: 1fr 1.2fr 1fr; gap: 0.5rem;
    padding: 0.5rem max(0.75rem, env(safe-area-inset-right)) max(0.5rem, env(safe-area-inset-bottom)) max(0.75rem, env(safe-area-inset-left));
    background: var(--paper); border-top: var(--line) solid var(--ink);
  }
  .ps-dock > * { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.1rem; padding: 0.35rem; border-radius: 0.8rem; font-size: 0.72rem; font-weight: 800; position: relative; }
  .ps-dock .is-main { background: var(--kunyit); border: 2px solid var(--ink); box-shadow: 3px 3px 0 var(--ink); }
  .ps-dock .ps-count { position: absolute; top: -0.4rem; right: 0.6rem; }
  .ps-toast {
    position: fixed; z-index: 60; left: 50%; bottom: calc(5.25rem + env(safe-area-inset-bottom)); translate: -50% 0;
    display: flex; align-items: center; gap: 1rem; max-width: calc(100vw - 2rem); padding: 0.75rem 1.1rem;
    background: var(--ink); color: var(--paper); border-radius: 999px; font-size: 0.9rem; font-weight: 600; white-space: nowrap;
    box-shadow: 4px 4px 0 var(--kunyit); animation: ps-toast 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.2);
  }
  .ps-toast [data-toast-text] { overflow: hidden; text-overflow: ellipsis; }
  @media (min-width: 768px) { .ps-toast { bottom: 2rem; } }
  dialog.ps-cart {
    margin: 0 0 0 auto; width: min(28rem, 100vw); max-width: 100vw; height: 100dvh; max-height: 100dvh; padding: 0;
    border: 0; border-left: var(--line) solid var(--ink); background: var(--paper); color: var(--ink);
  }
  dialog.ps-cart[open] { animation: ps-slide-in 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); }
  dialog.ps-cart::backdrop { background: rgb(36 22 15 / 0.55); backdrop-filter: blur(2px); }
  @media (max-width: 639px) {
    dialog.ps-cart { margin: auto 0 0; width: 100vw; height: auto; max-height: 90dvh; border-left: 0; border-top: var(--line) solid var(--ink); border-radius: 1.25rem 1.25rem 0 0; }
    dialog.ps-cart[open] { animation-name: ps-sheet-in; }
  }
  .ps-receipt {
    position: relative; background: #fff; padding: 1.25rem 1.1rem 1.4rem; border-radius: 4px 4px 0 0;
    box-shadow: 0 10px 20px -14px rgb(0 0 0 / 0.5);
  }
  .ps-receipt::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -10px; height: 10px;
    background: radial-gradient(circle at 8px 10px, transparent 6px, #fff 6.5px) 0 0 / 16px 10px repeat-x;
  }
  .ps-line { display: grid; grid-template-columns: 1fr auto; gap: 0.25rem 0.75rem; align-items: center; }
  .ps-qty { display: inline-flex; justify-self: start; align-items: center; border: 2px solid var(--ink); border-radius: 999px; overflow: hidden; }
  .ps-qty button { width: 1.9rem; height: 1.75rem; display: grid; place-items: center; }
  .ps-qty button:hover { background: var(--kunyit); }
  .ps-qty span { min-width: 1.6rem; text-align: center; font-weight: 800; font-family: var(--f-nota); }

  /* Reveal */
  .js [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); transition-delay: var(--rd, 0s); }
  .js [data-reveal].is-in { opacity: 1; transform: none; }

  @keyframes ps-settle { from { transform: scale(1.1); filter: saturate(0.6) brightness(0.8); } to { transform: scale(1); filter: none; } }
  @keyframes ps-swing { 0% { opacity: 0; transform: translateY(-28px) rotate(-5deg); } 55% { opacity: 1; transform: translateY(0) rotate(1.2deg); } 100% { transform: rotate(-0.6deg); } }
  @keyframes ps-fade { to { opacity: 1; } }
  @keyframes ps-draw { to { stroke-dashoffset: 0; } }
  @keyframes ps-steam { 0% { opacity: 0; transform: translateY(14px) scaleX(0.9); } 35% { opacity: 0.85; } 100% { opacity: 0; transform: translateY(-34px) scaleX(1.25); } }
  @keyframes ps-spin { to { transform: rotate(360deg); } }
  @keyframes ps-marquee { to { transform: translateX(-50%); } }
  @keyframes ps-pulse { 70% { box-shadow: 0 0 0 7px rgb(31 157 76 / 0); } 100% { box-shadow: 0 0 0 0 rgb(31 157 76 / 0); } }
  @keyframes ps-float { 50% { transform: translateY(-1.5px); } }
  @keyframes ps-rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes ps-pop { 0% { transform: rotate(-1.5deg) scale(1); } 40% { transform: rotate(1deg) scale(1.05); } 100% { transform: rotate(-1.5deg) scale(1); } }
  @keyframes ps-bump { 40% { transform: scale(1.45); } }
  @keyframes ps-plus1 { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(-2.2rem); } }
  @keyframes ps-toast { from { opacity: 0; transform: translateY(16px) scale(0.96); } }
  @keyframes ps-slide-in { from { transform: translateX(100%); } }
  @keyframes ps-sheet-in { from { transform: translateY(100%); } }

  @media (prefers-reduced-motion: reduce) {
    .ps *, .ps *::before, .ps *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
    .ps-marquee-track, .ps-stamp, .ps-steam { animation: none !important; }
    .js [data-reveal] { opacity: 1; transform: none; }
    html:has(.ps) { scroll-behavior: auto; }
  }
  }
</style>

<script>
  import { rupiah, wa } from '../../lib/util';
  import { biz, menu, hours, branches, photo, srcset, type Dish } from '../../data/restoran';

  const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => el.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => [...el.querySelectorAll<T>(s)];
  const dishes: Record<string, Dish> = Object.fromEntries(menu.flatMap((c) => c.dishes).map((d) => [d.id, d]));

  /* ---------- Open now (WIB) ---------- */
  const toMin = (t: string) => {
    const [h, m] = t.split(':').map(Number);
    return h * 60 + m;
  };
  const dot = (t: string) => t.replace(':', '.');
  function wibNow() {
    const p = Object.fromEntries(
      new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Jakarta', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' })
        .formatToParts(new Date())
        .map((x) => [x.type, x.value]),
    );
    return { day: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].indexOf(p.weekday), min: Number(p.hour) * 60 + Number(p.minute) };
  }
  function openStatus() {
    const { day, min } = wibNow();
    const h = hours[day];
    if (h.open && h.close && min >= toMin(h.open) && min < toMin(h.close)) {
      const soon = toMin(h.close) - min <= 45;
      return { open: true, text: soon ? `Segera tutup · ${dot(h.close)}` : `Buka · tutup ${dot(h.close)}` };
    }
    if (h.open && min < toMin(h.open)) return { open: false, text: `Tutup · buka ${dot(h.open)}` };
    for (let i = 1; i <= 7; i++) {
      const n = hours[(day + i) % 7];
      if (n.open) return { open: false, text: `Tutup · buka ${i === 1 ? 'besok' : n.day} ${dot(n.open)}` };
    }
    return { open: false, text: 'Tutup' };
  }
  function paintStatus() {
    const s = openStatus();
    $$('[data-open-status]').forEach((el) => {
      el.dataset.open = String(s.open);
      $('[data-status-text]', el).textContent = s.text;
    });
    const { day } = wibNow();
    $$('[data-hours-row]').forEach((row) => row.classList.toggle('is-today', Number(row.dataset.hoursRow) === day));
    const h = hours[day];
    $('[data-today-hours]').textContent = h.open ? `Hari ini ${dot(h.open)}–${dot(h.close!)}` : 'Hari ini libur';
  }
  paintStatus();
  setInterval(paintStatus, 60_000);

  /* ---------- Menu tabs + photo stage ---------- */
  const tabs = $$<HTMLButtonElement>('[role="tab"]');
  const panels = $$('[role="tabpanel"]');
  const ind = $('[data-tab-ind]');
  let current = 0;
  const moveInd = () => {
    const t = tabs[current];
    ind.style.width = `${t.offsetWidth}px`;
    ind.style.transform = `translateX(${t.offsetLeft}px)`;
  };
  function selectTab(i: number, focus = false) {
    current = i;
    tabs.forEach((t, j) => {
      t.setAttribute('aria-selected', String(j === i));
      t.tabIndex = j === i ? 0 : -1;
    });
    panels.forEach((p, j) => {
      p.hidden = j !== i;
      if (j === i) {
        p.classList.remove('is-anim');
        void p.offsetWidth;
        p.classList.add('is-anim');
      }
    });
    moveInd();
    if (focus) tabs[i].focus();
    const bar = tabs[i].parentElement!;
    bar.scrollTo({ left: tabs[i].offsetLeft - (bar.clientWidth - tabs[i].offsetWidth) / 2, behavior: 'smooth' });
    const firstDish = $('[data-dish]', panels[i]);
    if (firstDish) showDish(firstDish.dataset.dish!);
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => selectTab(i));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        selectTab((i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length, true);
      }
    });
  });
  document.fonts?.ready.then(moveInd);
  moveInd();
  new ResizeObserver(moveInd).observe($('.ps-tabs'));

  const layers = $$<HTMLImageElement>('[data-stage-img]');
  const cap = $('[data-stage-cap]');
  let front = 0;
  let shown = menu[0].dishes[0].id;
  function showDish(id: string) {
    if (id === shown) return;
    shown = id;
    const d = dishes[id];
    const back = layers[1 - front];
    back.srcset = srcset(d.photo, 1, [480, 800, 1100]);
    back.src = photo(d.photo, 800, 800);
    back.alt = d.name;
    $('[data-cap-name]').textContent = d.name;
    $('[data-cap-price]').textContent = rupiah(d.price);
    cap.classList.remove('flip');
    void cap.offsetWidth;
    cap.classList.add('flip');
    const swap = () => {
      if (shown !== id) return;
      back.classList.add('is-front');
      layers[front].classList.remove('is-front');
      layers[front].alt = '';
      front = 1 - front;
    };
    back.decode().then(swap, swap);
  }
  const fine = matchMedia('(hover: hover) and (min-width: 1024px)');
  $$('[data-dish]').forEach((el) => {
    el.addEventListener('pointerenter', () => fine.matches && showDish(el.dataset.dish!));
    el.addEventListener('focusin', () => showDish(el.dataset.dish!));
  });
  // Warm the cache for the stage photos once the menu is near.
  new IntersectionObserver((entries, obs) => {
    if (!entries[0].isIntersecting) return;
    obs.disconnect();
    if (!fine.matches) return;
    Object.values(dishes).forEach((d) => {
      const im = new Image();
      im.sizes = '50vw';
      im.srcset = srcset(d.photo, 1, [480, 800, 1100]);
    });
  }, { rootMargin: '400px' }).observe($('#menu'));

  /* ---------- Order (nota) ---------- */
  const KEY = 'pawon-simbah-nota';
  let cart = new Map<string, number>();
  try {
    cart = new Map((JSON.parse(localStorage.getItem(KEY) || '[]') as [string, number][]).filter(([id]) => dishes[id]));
  } catch {}
  const save = () => {
    try {
      localStorage.setItem(KEY, JSON.stringify([...cart]));
    } catch {}
  };
  const dlg = $<HTMLDialogElement>('#nota');
  const list = $('[data-cart-list]');
  const send = $<HTMLAnchorElement>('[data-cart-send]');
  const cartErr = $('[data-cart-error]');
  const oName = $<HTMLInputElement>('#o-name');
  const oTime = $<HTMLSelectElement>('#o-time');
  const oNote = $<HTMLInputElement>('#o-note');
  const oAddr = $<HTMLTextAreaElement>('#o-address');
  const mode = () => $<HTMLInputElement>('input[name="mode"]:checked').value;

  function totals() {
    let sum = 0;
    let count = 0;
    cart.forEach((q, id) => {
      sum += dishes[id].price * q;
      count += q;
    });
    return { sum, count };
  }
  function setQty(id: string, q: number) {
    if (q <= 0) cart.delete(id);
    else cart.set(id, Math.min(q, 50));
    save();
    render();
  }
  function render() {
    const { sum, count } = totals();
    $$('[data-cart-count]').forEach((el) => {
      el.textContent = String(count);
      el.hidden = count === 0;
    });
    $$('[data-inqty]').forEach((el) => {
      const q = cart.get(el.dataset.inqty!) || 0;
      el.hidden = q === 0;
      el.textContent = `${q} di nota`;
    });
    $('[data-cart-total]').textContent = rupiah(sum);
    $('[data-cart-empty]').hidden = count > 0;
    list.innerHTML = '';
    cart.forEach((q, id) => {
      const d = dishes[id];
      const li = document.createElement('li');
      li.className = 'ps-line';
      li.innerHTML = `
        <p class="f-nota text-sm font-bold leading-snug"></p>
        <p class="f-nota text-sm font-bold text-right">${rupiah(d.price * q)}</p>
        <div class="ps-qty">
          <button type="button" aria-label="Kurangi ${d.name}" data-q="-1">−</button><span>${q}</span><button type="button" aria-label="Tambah ${d.name}" data-q="1">+</button>
        </div>
        <p class="f-nota text-xs text-right opacity-70">@ ${rupiah(d.price)}</p>`;
      li.querySelector('p')!.textContent = d.name;
      li.querySelectorAll<HTMLButtonElement>('[data-q]').forEach((b) => b.addEventListener('click', () => setQty(id, q + Number(b.dataset.q))));
      list.append(li);
    });
    $('[data-cart-form]').hidden = count === 0;
    updateSend();
  }
  function orderText() {
    const { sum } = totals();
    const lines = [...cart].map(([id, q]) => `${q}x ${dishes[id].name} — ${rupiah(dishes[id].price * q)}`);
    const m = mode();
    return [
      `Halo ${biz.name}, saya mau pesan (dari website):`,
      '',
      ...lines,
      `Total: ${rupiah(sum)}`,
      '',
      `Nama: ${oName.value.trim()}`,
      `Cara: ${m}, ${oTime.value === 'Secepatnya' ? 'secepatnya' : `jam ${oTime.value}`}`,
      m === 'Diantar' ? `Alamat: ${oAddr.value.trim()}` : '',
      oNote.value.trim() ? `Catatan: ${oNote.value.trim()}` : '',
    ]
      .filter((l, i, a) => l !== '' || a[i - 1] !== '')
      .join('\n')
      .trim();
  }
  function updateSend() {
    send.href = wa(orderText());
  }
  send.addEventListener('click', (e) => {
    const problems = [];
    if (cart.size === 0) problems.push('Tambah minimal satu menu.');
    if (!oName.value.trim()) problems.push('Isi nama dulu ya.');
    if (mode() === 'Diantar' && !oAddr.value.trim()) problems.push('Alamat antar belum diisi.');
    oName.setAttribute('aria-invalid', String(!oName.value.trim() && cart.size > 0));
    oAddr.setAttribute('aria-invalid', String(mode() === 'Diantar' && !oAddr.value.trim()));
    cartErr.hidden = problems.length === 0;
    cartErr.textContent = problems.join(' ');
    if (problems.length) {
      e.preventDefault();
      (cart.size === 0 ? null : !oName.value.trim() ? oName : oAddr)?.focus();
    }
  });
  [oName, oTime, oNote, oAddr].forEach((el) => el.addEventListener('input', updateSend));
  $$<HTMLInputElement>('input[name="mode"]').forEach((r) =>
    r.addEventListener('change', () => {
      $('[data-address]').hidden = mode() !== 'Diantar';
      updateSend();
    }),
  );

  const toast = $('[data-toast]');
  let toastTimer = 0;
  function showToast(text: string) {
    $('[data-toast-text]').textContent = text;
    toast.hidden = false;
    toast.style.animation = 'none';
    void toast.offsetWidth;
    toast.style.animation = '';
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (toast.hidden = true), 2600);
  }
  $$<HTMLButtonElement>('[data-add]').forEach((b) =>
    b.addEventListener('click', () => {
      const id = b.dataset.add!;
      setQty(id, (cart.get(id) || 0) + 1);
      showToast(`${dishes[id].name} masuk nota`);
      const plus = document.createElement('span');
      plus.className = 'ps-plus1';
      plus.textContent = '+1';
      plus.setAttribute('aria-hidden', 'true');
      b.append(plus);
      plus.addEventListener('animationend', () => plus.remove());
      $$('[data-cart-count]').forEach((c) => {
        c.classList.remove('bump');
        void c.offsetWidth;
        c.classList.add('bump');
      });
    }),
  );
  document.addEventListener('click', (e) => {
    const t = (e.target as Element).closest('[data-cart-open]');
    if (!t) return;
    toast.hidden = true;
    dlg.showModal();
  });
  $('[data-cart-close]').addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });
  render();

  /* ---------- Reservation ---------- */
  const form = $<HTMLFormElement>('[data-resv]');
  const rDate = $<HTMLInputElement>('#r-date');
  const rPeople = $<HTMLInputElement>('#r-people');
  const rErr = $('[data-resv-error]');
  const wibDate = (offsetDays = 0) =>
    new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jakarta' }).format(new Date(Date.now() + offsetDays * 864e5));
  rDate.min = wibDate();
  rDate.value = (() => {
    for (let i = 1; i < 8; i++) {
      const v = wibDate(i);
      const dow = (new Date(`${v}T12:00:00`).getDay() + 6) % 7;
      if (hours[dow].open) return v;
    }
    return wibDate(1);
  })();
  $$<HTMLButtonElement>('[data-step]').forEach((b) =>
    b.addEventListener('click', () => {
      const v = Math.min(60, Math.max(1, (Number(rPeople.value) || 1) + Number(b.dataset.step)));
      rPeople.value = String(v);
    }),
  );
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const date = String(data.get('date') || '');
    const people = Math.round(Number(data.get('people')));
    const problems: string[] = [];
    const fields: [string, boolean][] = [];
    if (!name) problems.push('Isi nama pemesan.');
    fields.push(['#r-name', !name]);
    let dateBad = !date || date < rDate.min;
    if (!date) problems.push('Pilih tanggal.');
    else if (date < rDate.min) problems.push('Tanggalnya sudah lewat.');
    else {
      const dow = (new Date(`${date}T12:00:00`).getDay() + 6) % 7;
      if (!hours[dow].open) {
        problems.push(`${hours[dow].day} kami libur. Pilih hari lain ya.`);
        dateBad = true;
      }
    }
    fields.push(['#r-date', dateBad]);
    const peopleBad = !(people >= 1 && people <= 60);
    if (peopleBad) problems.push('Jumlah orang 1–60. Lebih dari itu, chat kami langsung.');
    fields.push(['#r-people', peopleBad]);
    fields.forEach(([sel, bad]) => $(sel).setAttribute('aria-invalid', String(bad)));
    rErr.hidden = problems.length === 0;
    rErr.textContent = problems.join(' ');
    if (problems.length) {
      const firstBad = fields.find(([, bad]) => bad);
      if (firstBad) $(firstBad[0]).focus();
      return;
    }
    const nice = new Intl.DateTimeFormat('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${date}T12:00:00`));
    const note = String(data.get('note') || '').trim();
    const text = [
      `Halo ${biz.name}, saya mau reservasi meja (dari website):`,
      '',
      `Nama: ${name}`,
      `Tanggal: ${nice}, jam ${String(data.get('time')).replace(':', '.')}`,
      `Jumlah: ${people} orang`,
      `Area: ${data.get('area')}`,
      `Acara: ${data.get('event')}`,
      note ? `Catatan: ${note}` : '',
    ]
      .filter(Boolean)
      .join('\n');
    window.open(wa(text), '_blank', 'noopener');
  });

  /* ---------- Kitchen carousel ---------- */
  const track = $('[data-track]');
  const bar = $('[data-track-bar]');
  const step = () => (track.querySelector<HTMLElement>('.ps-card')?.offsetWidth ?? 300) + 24;
  $('[data-prev]').addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
  $('[data-next]').addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  const paintBar = () => {
    const max = track.scrollWidth - track.clientWidth;
    const view = track.clientWidth / track.scrollWidth;
    bar.style.transform = `scaleX(${max > 0 ? view + (1 - view) * (track.scrollLeft / max) : 1})`;
  };
  track.addEventListener('scroll', paintBar, { passive: true });
  addEventListener('resize', paintBar);
  paintBar();
  let drag = { on: false, x: 0, left: 0, moved: false };
  track.addEventListener('pointerdown', (e) => {
    if (e.pointerType !== 'mouse') return;
    drag = { on: true, x: e.clientX, left: track.scrollLeft, moved: false };
  });
  addEventListener('pointermove', (e) => {
    if (!drag.on) return;
    const dx = e.clientX - drag.x;
    if (!drag.moved && Math.abs(dx) > 5) {
      drag.moved = true;
      track.classList.add('is-drag');
    }
    if (drag.moved) track.scrollLeft = drag.left - dx;
  });
  addEventListener('pointerup', () => {
    if (!drag.on) return;
    drag.on = false;
    if (drag.moved) {
      const left = track.scrollLeft;
      track.classList.remove('is-drag');
      track.scrollLeft = left;
      const s = step();
      track.scrollTo({ left: Math.round(left / s) * s, behavior: 'smooth' });
    }
  });

  /* ---------- Branch switcher ---------- */
  let bi = 0;
  const showBranch = (d: number) => {
    bi = (bi + d + branches.length) % branches.length;
    const b = branches[bi];
    $('[data-branch-name]').textContent = b.name;
    $('[data-branch-note]').textContent = b.note;
    $('[data-branch-address]').textContent = b.address;
    $<HTMLAnchorElement>('[data-branch-maps]').href = b.maps;
    $('[data-branch-count]').textContent = `${bi + 1} / ${branches.length}`;
  };
  $('[data-branch-prev]').addEventListener('click', () => showBranch(-1));
  $('[data-branch-next]').addEventListener('click', () => showBranch(1));

  /* ---------- Reveal on scroll ---------- */
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      }),
    { rootMargin: '0px 0px -8% 0px' },
  );
  $$('[data-reveal]').forEach((el) => io.observe(el));
</script>
