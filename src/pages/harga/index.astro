---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { url, rupiah, PORTFOLIO } from '../../lib/util';
import { kategori, included, addons, maintenance, steps, faqs, waTo } from '../../data/harga';

const CHECK = 'M5 12.5l4.5 4.5L19 7.5';
const ARROW = 'M5 12h14M13 6l6 6-6 6';
const WA_ICON =
  'M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.6l-4.5.9zM9 8.5c0 3.5 3 6.5 6.5 6.5l1.2-1.4-1.9-1-1 .8c-1.2-.5-2.2-1.5-2.7-2.7l.8-1-1-1.9z';

const consult = waTo('Halo, saya ingin berkonsultasi tentang pembuatan website.');
const order = (cat: string, name: string) =>
  waTo(`Halo, saya tertarik dengan paket ${cat} – ${name}. Boleh minta informasi lebih lanjut?`);
---

<Base
  title="Harga Jasa Pembuatan Website — Purbo Panambang"
  description="Daftar harga jasa pembuatan landing page, company profile, dan toko online untuk UMKM dan bisnis di Indonesia. Mulai Rp1,5 juta, sudah termasuk domain dan hosting."
  bodyClass="min-h-screen bg-slate-950 font-sans text-slate-300"
  bare
  noindex={false}
>
  <header class="sticky top-0 z-40 border-b border-slate-800/80 bg-slate-950/85 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3">
      <a href={url('harga')} class="leading-tight">
        <span class="block font-semibold text-white">Purbo Panambang</span>
        <span class="block text-xs text-slate-400">Jasa Pembuatan Website</span>
      </a>
      <nav class="hidden items-center gap-6 text-sm md:flex">
        {kategori.map((k) => <a href={`#${k.id}`} class="hover:text-white">{k.title}</a>)}
        <a href="#pemeliharaan" class="hover:text-white">Maintenance</a>
        <a href={url('/')} class="hover:text-white">Contoh Website</a>
      </nav>
      <a
        href={consult}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full bg-emerald-500 px-4 py-2 text-sm font-semibold whitespace-nowrap text-slate-950 hover:bg-emerald-400"
      >
        <Icon d={WA_ICON} class="h-4 w-4" /> Konsultasi
      </a>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="mx-auto max-w-6xl px-5 pt-16 pb-12 sm:pt-24">
      <p class="text-sm font-semibold tracking-widest text-amber-400 uppercase">Daftar Harga</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
        Jasa pembuatan website untuk bisnis Indonesia
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-400">
        Landing page, company profile, dan toko online yang cepat diakses dari HP serta terhubung dengan WhatsApp, QRIS,
        dan ongkos kirim kurir lokal. Harga transparan, sudah termasuk domain dan hosting untuk tahun pertama.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        {
          kategori.map((k) => (
            <a
              href={`#${k.id}`}
              class="rounded-full border border-slate-700 px-4 py-2 text-sm text-slate-200 hover:border-slate-500 hover:text-white"
            >
              {k.title}{' '}
              <span class="text-amber-400">
                mulai {rupiah(Math.min(...k.pakets.map((p) => p.price)) / 1_000_000)} juta
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Package categories -->
    {
      kategori.map((k) => (
        <section id={k.id} class="mx-auto max-w-6xl scroll-mt-20 px-5 py-12">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div class="max-w-2xl">
              <h2 class="text-2xl font-bold text-white sm:text-3xl">{k.title}</h2>
              <p class="mt-2 text-slate-400">{k.blurb}</p>
            </div>
            {k.demo && (
              <a href={url(k.demo.href)} class="text-sm font-semibold text-amber-400 hover:text-amber-300">
                {k.demo.label} →
              </a>
            )}
          </div>

          <div class={`mt-8 grid gap-6 ${k.pakets.length === 3 ? 'lg:grid-cols-3' : 'md:grid-cols-2'}`}>
            {k.pakets.map((p) => (
              <div
                class={`relative flex flex-col rounded-2xl border p-6 sm:p-7 ${
                  p.featured
                    ? 'border-amber-400/70 bg-slate-900 shadow-lg shadow-amber-500/5'
                    : 'border-slate-800 bg-slate-900/50'
                }`}
              >
                {p.featured && (
                  <span class="absolute -top-3 left-6 rounded-full bg-amber-400 px-3 py-0.5 text-xs font-semibold text-slate-950">
                    Paling diminati
                  </span>
                )}
                <p class="text-xs font-semibold tracking-wider text-slate-500 uppercase">{k.title}</p>
                <h3 class="mt-1 text-xl font-semibold text-white">{p.name}</h3>
                <p class="mt-4 text-sm text-slate-400">Mulai dari</p>
                <p class="text-3xl font-bold tracking-tight text-white">{rupiah(p.price)}</p>
                <p class="mt-1 text-sm text-slate-400">Waktu pengerjaan {p.time}</p>
                <ul class="mt-6 flex-1 space-y-3 text-sm">
                  {p.features.map((f) => (
                    <li class="flex gap-2.5">
                      <Icon d={CHECK} class="mt-0.5 h-4 w-4 shrink-0 text-emerald-400" />
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
                <a
                  href={order(k.title, p.name)}
                  target="_blank"
                  rel="noopener"
                  class={`mt-7 inline-flex items-center justify-center gap-2 rounded-xl px-4 py-3 text-sm font-semibold ${
                    p.featured
                      ? 'bg-amber-400 text-slate-950 hover:bg-amber-300'
                      : 'bg-slate-800 text-white hover:bg-slate-700'
                  }`}
                >
                  {p.from ? 'Minta penawaran' : 'Pilih paket ini'} <Icon d={ARROW} class="h-4 w-4" />
                </a>
              </div>
            ))}
          </div>
        </section>
      ))
    }

    <!-- Included in every package -->
    <section class="border-y border-slate-800 bg-slate-900/40">
      <div class="mx-auto max-w-6xl px-5 py-14">
        <h2 class="text-2xl font-bold text-white">Semua paket sudah termasuk</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            included.map((i) => (
              <div>
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-400">
                  <Icon d={CHECK} class="h-5 w-5" />
                </div>
                <h3 class="mt-4 font-semibold text-white">{i.title}</h3>
                <p class="mt-1 text-sm text-slate-400">{i.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Add-ons -->
    <section class="mx-auto max-w-6xl px-5 py-14">
      <h2 class="text-2xl font-bold text-white">Biaya tambahan</h2>
      <p class="mt-2 text-slate-400">Untuk kebutuhan di luar isi paket.</p>
      <dl class="mt-6 divide-y divide-slate-800 rounded-2xl border border-slate-800">
        {
          addons.map((a) => (
            <div class="flex flex-wrap items-center justify-between gap-2 px-5 py-4">
              <dt class="text-slate-200">{a.name}</dt>
              <dd class="font-semibold text-white">{a.price}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Maintenance -->
    <section id="pemeliharaan" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-12">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">Pemeliharaan Website (Maintenance)</h2>
      <p class="mt-2 max-w-2xl text-slate-400">
        Layanan bulanan opsional agar website tetap aman, rutin dicadangkan, dan selalu dapat diakses. Perpanjangan domain
        dan hosting saya urus, sehingga Anda bisa fokus mengembangkan bisnis.
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          maintenance.map((m) => (
            <div
              class={`flex flex-col rounded-2xl border p-6 ${
                m.featured ? 'border-amber-400/70 bg-slate-900' : 'border-slate-800 bg-slate-900/50'
              }`}
            >
              <h3 class="text-lg font-semibold text-white">{m.name}</h3>
              <p class="mt-3">
                <span class="text-2xl font-bold text-white">{rupiah(m.price)}</span>
                <span class="text-sm text-slate-400"> / bulan</span>
              </p>
              <ul class="mt-5 flex-1 space-y-2.5 text-sm">
                {m.features.map((f) => (
                  <li class="flex gap-2.5">
                    <Icon d={CHECK} class="mt-0.5 h-4 w-4 shrink-0 text-emerald-400" />
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
              <a
                href={order('Pemeliharaan Website', m.name)}
                target="_blank"
                rel="noopener"
                class="mt-6 text-sm font-semibold text-amber-400 hover:text-amber-300"
              >
                Tanya paket ini →
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Process -->
    <section class="mx-auto max-w-6xl px-5 py-14">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">Cara kerja</h2>
      <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          steps.map((s, i) => (
            <li class="rounded-2xl border border-slate-800 p-6">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-amber-400 text-sm font-bold text-slate-950">
                {i + 1}
              </span>
              <h3 class="mt-4 font-semibold text-white">{s.title}</h3>
              <p class="mt-1 text-sm text-slate-400">{s.desc}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- FAQ -->
    <section class="mx-auto max-w-3xl px-5 py-14">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">Pertanyaan yang sering ditanyakan</h2>
      <div class="mt-8 divide-y divide-slate-800 border-y border-slate-800">
        {
          faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-medium text-white">
                {f.q}
                <span class="text-xl text-slate-500 transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-slate-400">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-6xl px-5 pt-6 pb-20">
      <div class="rounded-3xl bg-gradient-to-br from-amber-400 to-orange-500 p-8 text-slate-950 sm:p-12">
        <h2 class="max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">Belum yakin paket mana yang cocok?</h2>
        <p class="mt-3 max-w-xl text-slate-900/80">
          Ceritakan kebutuhan bisnis Anda, saya bantu memilihkan paket yang tepat. Konsultasi gratis dan tanpa komitmen.
        </p>
        <a
          href={consult}
          target="_blank"
          rel="noopener"
          class="mt-7 inline-flex items-center gap-2 rounded-full bg-slate-950 px-6 py-3 font-semibold text-white hover:bg-slate-800"
        >
          <Icon d={WA_ICON} class="h-5 w-5" /> Hubungi via WhatsApp
        </a>
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-800">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5 py-8 text-sm text-slate-500">
      <p>
        © 2026 <a href={PORTFOLIO} class="text-slate-300 hover:underline">Purbo Panambang</a>. Harga dapat berubah
        sewaktu-waktu.
      </p>
      <a href={url('/')} class="text-slate-300 hover:underline">Lihat contoh website →</a>
    </div>
  </footer>
</Base>
