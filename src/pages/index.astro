---
import Base from '../layouts/Base.astro';
import { url, PORTFOLIO } from '../lib/util';

const demos = [
  {
    href: 'klinik',
    name: 'Klinik Gigi Arunika',
    type: 'Company Profile',
    desc: 'Website profil klinik: layanan & harga, dokter, jadwal praktik, lokasi, dan form janji temu yang langsung terkirim ke WhatsApp.',
    features: ['Jadwal praktik', 'Form janji → WhatsApp', 'Harga layanan', 'FAQ'],
    swatch: 'from-teal-500 to-cyan-600',
  },
  {
    href: 'catering',
    name: 'Dapur Sehari',
    type: 'Landing Page',
    desc: 'Landing page untuk iklan Instagram/TikTok: menu mingguan, paket langganan, testimoni, dan tombol pesan via WhatsApp di setiap paket.',
    features: ['Fokus konversi', 'Paket harga', 'Tombol WA melayang', 'Siap Meta Pixel'],
    swatch: 'from-orange-500 to-lime-500',
  },
  {
    href: 'toko',
    name: 'Kopi Lereng',
    type: 'Toko Online',
    desc: 'Toko online kopi: filter produk, keranjang, hitung ongkir per kota & kurir, pilihan QRIS / Virtual Account / e-wallet, atau pesan via WhatsApp.',
    features: ['Keranjang', 'Ongkir per kurir', 'Simulasi QRIS & VA', 'Checkout WhatsApp'],
    swatch: 'from-amber-700 to-stone-800',
  },
  {
    href: 'mancing',
    name: 'Joran Senja',
    type: 'Website Komunitas',
    desc: 'Website komunitas mancing: video latar, profil kru, jadwal trip, spot favorit, peralatan, galeri foto, dan form gabung via WhatsApp.',
    features: ['Video & galeri', 'Profil anggota', 'Jadwal trip', 'Form gabung → WA'],
    swatch: 'from-orange-500 to-sky-900',
  },
];
---

<Base
  title="Demo Website — Purbo Panambang"
  description="Contoh website company profile, landing page, dan toko online untuk bisnis Indonesia."
  bodyClass="min-h-screen bg-slate-950 font-sans text-slate-300"
  bare
>
  <main class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
    <p class="text-sm font-semibold tracking-widest text-amber-400 uppercase">Demo Website</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
      Website cepat dan aman untuk bisnis Indonesia
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-400">
      Empat contoh situs untuk bisnis dan komunitas fiktif. Semua dibuat ringan untuk HP Android dan internet seluler, dengan
      Cloudflare di depannya, dan bisa terhubung ke WhatsApp, QRIS, Virtual Account, serta ongkir kurir lokal.
    </p>

    <a
      href={url('harga')}
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-amber-400 px-5 py-2.5 text-sm font-semibold text-slate-950 hover:bg-amber-300"
    >
      Lihat daftar harga →
    </a>

    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        demos.map((d) => (
          <a
            href={url(d.href)}
            class="group flex flex-col overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60 transition hover:-translate-y-1 hover:border-slate-600"
          >
            <div class={`h-32 bg-gradient-to-br ${d.swatch} p-5`}>
              <span class="rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-slate-900">{d.type}</span>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h2 class="text-xl font-semibold text-white">{d.name}</h2>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">{d.desc}</p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {d.features.map((f) => (
                  <li class="rounded-full bg-slate-800 px-2.5 py-1 text-xs text-slate-300">{f}</li>
                ))}
              </ul>
              <span class="mt-6 text-sm font-semibold text-amber-400 group-hover:text-amber-300">Buka demo →</span>
            </div>
          </a>
        ))
      }
    </div>

    <p class="mt-16 text-sm text-slate-500">
      Semua nama bisnis, orang, harga, dan ulasan di keempat demo ini fiktif. Foto dan video komunitas mancing dari Unsplash dan Pexels. Dibuat oleh
      <a href={PORTFOLIO} class="text-slate-300 underline-offset-2 hover:underline">Purbo Panambang</a>.
    </p>
  </main>
</Base>
