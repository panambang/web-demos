  .jt-shot { position: relative; display: block; width: 100%; overflow: hidden; border-radius: 8px; border: 1px solid var(--line-c); cursor: zoom-in; }
  .jt-shot img { transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.4s; filter: saturate(0.85); }
  .jt-shot:hover img { transform: scale(1.05); filter: saturate(1.05); }
  .jt-shot-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 2rem 1rem 0.9rem; background: linear-gradient(transparent, rgb(0 0 0 / 0.8)); font-weight: 600; font-size: 0.95rem; text-align: left; transform: translateY(100%); transition: transform 0.35s ease; }
  .jt-shot:hover .jt-shot-cap, .jt-shot:focus-visible .jt-shot-cap { transform: none; }
  @media (hover: none) { .jt-shot-cap { transform: none; } }
  .jt-lightbox { width: 100vw; height: 100dvh; max-width: 100vw; max-height: 100dvh; margin: 0; padding: 0; border: 0; background: rgb(10 10 11 / 0.96); color: var(--cat); }
  .jt-lightbox[open] { animation: jt-fade 0.25s ease; }
  .jt-lightbox::backdrop { background: rgb(0 0 0 / 0.6); }
  .jt-lightbox img { border-radius: 6px; animation: jt-zoom 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .jt-lb-nav { position: absolute; top: 50%; translate: 0 -50%; }

  /* Merch */
  .jt-product { display: flex; flex-direction: column; background: #fff; border: 3px solid var(--ink); border-radius: 10px; overflow: hidden; transition: transform 0.25s, box-shadow 0.25s; }
  .jt-product:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 var(--ink); }
  .jt-product-art { position: relative; display: grid; place-items: center; aspect-ratio: 5 / 4; padding: 1rem; border-bottom: 3px solid var(--ink); overflow: hidden; }
  .jt-product-art svg { width: 82%; transition: transform 0.5s cubic-bezier(0.3, 1.4, 0.5, 1); }
  .jt-product:hover .jt-product-art svg { transform: scale(1.06) rotate(-2deg); }
  .art-jacket { background: #d9d4c7; } .art-tee { background: var(--kuning); } .art-patch { background: #c9d7cf; } .art-sticker { background: #2a2d31; }
  .jt-badge { position: absolute; top: 0.75rem; left: 0.75rem; padding: 0.2rem 0.5rem; background: var(--ink); color: var(--kuning); font-family: var(--f-stencil); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; border-radius: 3px; }
  .jt-size { min-width: 2.4rem; padding: 0.3rem 0.5rem; border: 2px solid var(--ink); border-radius: 5px; font-family: var(--f-display); font-weight: 900; transition: background-color 0.15s, color 0.15s; }
  .jt-size:hover { background: var(--semen); }
  .jt-size[aria-checked='true'] { background: var(--ink); color: var(--kuning); }

  /* Sponsors */
  .jt-sponsors { background: var(--aspal); }
  .jt-marquee { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .jt-marquee-track { display: flex; width: max-content; animation: jt-marquee 34s linear infinite; }
  .jt-marquee:hover .jt-marquee-track { animation-play-state: paused; }
  .jt-sponsor { padding: 0 2.25rem; white-space: nowrap; color: var(--cat); opacity: 0.75; transition: opacity 0.2s, color 0.2s; }
  .jt-sponsor:hover { opacity: 1; color: var(--kuning); }
  .jt-sponsor.s0 { font-family: var(--f-display); font-weight: 900; font-size: 1.7rem; text-transform: uppercase; }
  .jt-sponsor.s1 { font-family: var(--f-marker); font-size: 1.45rem; }
  .jt-sponsor.s2 { font-family: var(--f-stencil); font-size: 1.4rem; letter-spacing: 0.08em; }
  .jt-sponsor.s3 { font-weight: 700; font-size: 1.35rem; font-style: italic; letter-spacing: -0.01em; }

  /* Join */
  .jt-join { background: var(--aspal); background-image: radial-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1.4px); background-size: 6px 6px; }
  .jt-form { padding: 1.5rem; border: 1px solid var(--line-c); border-radius: 12px; background: var(--aspal-2); }
  @media (min-width: 640px) { .jt-form { padding: 2rem; } }
  .jt-field { display: grid; gap: 0.4rem; min-width: 0; border: 0; padding: 0; margin: 0; }
  .jt-field > span, .jt-field > legend { font-family: var(--f-stencil); font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .jt-field input, .jt-field select {
    width: 100%; padding: 0.8rem 0.9rem; border: 2px solid var(--line-c); border-radius: 6px; background: var(--aspal); color: var(--cat);
    font: inherit; font-size: 1rem; transition: border-color 0.15s, box-shadow 0.15s;
  }
  .jt-field input::placeholder { color: #6d6c67; }
  .jt-field input:focus, .jt-field select:focus { outline: none; border-color: var(--kuning); box-shadow: 0 0 0 3px rgb(255 194 26 / 0.2); }
  .jt-field [aria-invalid='true'] { border-color: var(--oranye); }
  #j-plate { font-family: var(--f-display); font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  .jt-chip { cursor: pointer; }
  .jt-chip span { display: grid; place-items: center; height: 2.9rem; border: 2px solid var(--line-c); border-radius: 6px; font-family: var(--f-display); font-weight: 900; font-size: 1.2rem; transition: background-color 0.15s, border-color 0.15s, color 0.15s; }
  .jt-chip:hover span { border-color: #666; }
  .jt-chip input:checked + span { background: var(--kuning); border-color: var(--kuning); color: var(--ink); }
  .jt-chip input:focus-visible + span { outline: 3px solid var(--kuning); outline-offset: 2px; }
  .jt-check { display: flex; align-items: flex-start; gap: 0.7rem; cursor: pointer; font-size: 0.95rem; color: var(--cat); }
  .jt-check input { flex-shrink: 0; width: 1.3rem; height: 1.3rem; margin-top: 0.1rem; accent-color: var(--kuning); }
  .jt-check input[aria-invalid='true'] { outline: 2px solid var(--oranye); outline-offset: 2px; }
  .jt-error { color: var(--oranye); font-weight: 700; }
  .jt-kta-wrap { perspective: 1200px; }
  .jt-kta {
    position: relative; overflow: hidden; aspect-ratio: 1.586; max-width: 30rem; margin-inline: auto; padding: 1.25rem 1.4rem; border-radius: 16px;
    background: linear-gradient(135deg, #24272b 0%, #141517 55%, #1d1f22 100%); border: 1px solid #3a3d42;
    box-shadow: 0 30px 60px -25px rgb(0 0 0 / 0.9), inset 0 1px 0 rgb(255 255 255 / 0.08);
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform 0.4s ease; transform-style: preserve-3d;
    display: flex; flex-direction: column; justify-content: space-between;
  }
  .jt-kta.is-tilting { transition: transform 0.08s linear; }
  @media (max-width: 420px) { .jt-kta { aspect-ratio: auto; } }
  .jt-kta-stripe { position: absolute; left: 0; right: 0; top: 0; height: 9px; background: repeating-linear-gradient(-45deg, var(--kuning) 0 10px, var(--ink) 10px 20px); }
  .jt-kta-glare { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at var(--gx, 30%) var(--gy, 20%), rgb(255 255 255 / 0.16), transparent 45%); }
  .jt-kta-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem 1rem; }
  .jt-kta-grid dt { font-family: var(--f-stencil); font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  .jt-kta-grid dd { margin: 0.1rem 0 0; font-weight: 700; font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .jt-kta.bump { animation: jt-bump 0.3s ease; }
  .jt-barcode { width: 9rem; height: 1.7rem; background: repeating-linear-gradient(90deg, var(--cat) 0 2px, transparent 2px 4px, var(--cat) 4px 5px, transparent 5px 8px, var(--cat) 8px 11px, transparent 11px 12px); opacity: 0.8; }
  .jt-steps { display: grid; gap: 1.25rem; counter-reset: s; }
  .jt-steps li { display: flex; gap: 1rem; }
  .jt-step-n { display: grid; place-items: center; flex-shrink: 0; width: 2.75rem; height: 2.75rem; border-radius: 6px; background: var(--kuning); color: var(--ink); font-family: var(--f-display); font-weight: 900; font-size: 1.5rem; }
  .jt-faq { border: 1px solid var(--line-c); border-radius: 8px; background: var(--aspal-2); transition: border-color 0.2s; }
  .jt-faq[open] { border-color: var(--kuning); }
  .jt-faq summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.1rem; font-weight: 700; font-size: 1.05rem; }
  .jt-faq p { padding: 0 1.1rem 1.1rem; color: rgb(241 237 228 / 0.8); }
  .jt-faq-x { position: relative; flex-shrink: 0; width: 1rem; height: 1rem; }
  .jt-faq-x::before, .jt-faq-x::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 2.5px; margin-top: -1.25px; background: var(--kuning); transition: transform 0.25s; }
  .jt-faq-x::after { transform: rotate(90deg); }
  .jt-faq[open] .jt-faq-x::after { transform: rotate(0); }

  /* Footer & dock */
  .jt-footer { background: #0e0f10; }
  .jt-contact { display: flex; flex-direction: column; gap: 0.3rem; padding: 0.9rem 1.1rem; border: 1px solid var(--line-c); border-radius: 8px; transition: border-color 0.2s, transform 0.2s; }
  .jt-contact:hover { border-color: var(--kuning); transform: translateY(-2px); }
  .jt-dock {
    position: fixed; inset: auto 0 0; z-index: 45; display: grid; grid-template-columns: 1fr 1.25fr 1fr; gap: 0.5rem;
    padding: 0.5rem max(0.75rem, env(safe-area-inset-right)) max(0.5rem, env(safe-area-inset-bottom)) max(0.75rem, env(safe-area-inset-left));
    background: rgb(14 15 16 / 0.96); backdrop-filter: blur(8px); border-top: 1px solid var(--line-c);
  }
  .jt-dock > a { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.15rem; padding: 0.4rem; border-radius: 8px; font-family: var(--f-display); font-weight: 800; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--cat); }
  .jt-dock .is-main { background: var(--kuning); color: var(--ink); }

  /* Reveal */
  .js [data-reveal] { opacity: 0; transform: translateY(22px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); transition-delay: var(--rd, 0s); }
  .js [data-reveal].is-in { opacity: 1; transform: none; }

  @keyframes jt-settle { from { transform: scale(1.12); filter: brightness(0.6) saturate(0.5); } to { transform: scale(1); filter: none; } }
  @keyframes jt-up { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes jt-rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes jt-stick { from { opacity: 0; transform: rotate(calc(var(--r) - 8deg)) scale(1.4); } to { opacity: 1; transform: rotate(var(--r)) scale(1); } }
  @keyframes jt-draw { to { stroke-dashoffset: 0; } }
  @keyframes jt-dash { to { background-position: -84px 0; } }
  @keyframes jt-odo { from { transform: translateY(0); } }
  @keyframes jt-pulse { 70% { box-shadow: 0 0 0 8px rgb(255 106 26 / 0); } 100% { box-shadow: 0 0 0 0 rgb(255 106 26 / 0); } }
  @keyframes jt-lane { to { transform: translateY(52px); } }
  @keyframes jt-wobble { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(1.5px, -3px); } }
  @keyframes jt-wobble-on { 0%, 100% { transform: translate(0, 0) scale(1.18); } 50% { transform: translate(1.5px, -3px) scale(1.18); } }
  @keyframes jt-card { 0% { transform: translateY(0); } 35% { transform: translateY(-6px) rotate(-0.6deg); } 100% { transform: none; } }
  @keyframes jt-marquee { to { transform: translateX(-50%); } }
  @keyframes jt-fade { from { opacity: 0; } }
  @keyframes jt-zoom { from { opacity: 0; transform: scale(0.94); } }
  @keyframes jt-bump { 50% { scale: 1.015; } }

  @media (prefers-reduced-motion: reduce) {
    .jt *, .jt *::before, .jt *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
    .jt-dash, .jt-lane, .jt-bike-in, .jt-marquee-track, .jt-live { animation: none !important; }
    .js [data-reveal] { opacity: 1; transform: none; }
  }
  }
</style>

<script>
  import { wa, rupiah } from '../../lib/util';
  import { club, chapters, gallery, photo, srcset } from '../../data/touring';

  const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => el.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => [...el.querySelectorAll<T>(s)];

  /* ---------- Countdown to each event (WIB) ---------- */
  const todayWIB = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jakarta' }).format(new Date());
  const daysUntil = (iso: string) => Math.round((Date.parse(`${iso}T00:00:00Z`) - Date.parse(`${todayWIB}T00:00:00Z`)) / 864e5);
  $$('[data-countdown]').forEach((el) => {
    const d = daysUntil(el.dataset.countdown!);
    el.textContent = d > 1 ? `${d} hari lagi` : d === 1 ? 'besok' : d === 0 ? 'hari ini' : 'selesai';
    if (d < 0) el.closest('.jt-event')?.classList.add('is-past');
  });

  /* ---------- Agenda filter ---------- */
  const filterBtns = $$<HTMLButtonElement>('[data-filter]');
  const eventCards = $$('.jt-event');
  filterBtns.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter;
      filterBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let shown = 0;
      eventCards.forEach((c) => {
        const on = f === 'semua' || c.dataset.type === f;
        c.hidden = !on;
        if (on) {
          shown++;
          c.animate([{ opacity: 0, transform: 'translateY(14px)' }, { opacity: 1, transform: 'none' }], { duration: 350, delay: shown * 50, easing: 'ease-out', fill: 'backwards' });
        }
      });
      $('[data-events-empty]').classList.toggle('hidden', shown > 0);
    }),
  );

  /* ---------- Stat counters ---------- */
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const countUp = (el: HTMLElement) => {
    const target = Number(el.dataset.count);
    if (reduce || target === 0) return;
    const t0 = performance.now();
    const dur = 1400;
    const tick = (t: number) => {
      const p = Math.min(1, (t - t0) / dur);
      el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3))).toLocaleString('id-ID');
      if (p < 1) requestAnimationFrame(tick);
    };
    el.textContent = '0';
    requestAnimationFrame(tick);
  };

  /* ---------- Formation roles ---------- */
  const roleBtns = $$<HTMLButtonElement>('[data-role]');
  const markers = $$('[data-marker]');
  const setRole = (id: string) => {
    roleBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.role === id)));
    markers.forEach((m) => m.classList.toggle('is-on', m.dataset.marker === id));
  };
  roleBtns.forEach((b) => {
    b.addEventListener('click', () => setRole(b.dataset.role!));
    b.addEventListener('mouseenter', () => setRole(b.dataset.role!));
  });
  setRole('rc');

  /* ---------- Hand signal cards ---------- */
  $$<HTMLButtonElement>('.jt-signal').forEach((b) =>
    b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'))),
  );

  /* ---------- Chapters ---------- */
  const card = $('#chapter-card');
  const stations = $$<HTMLButtonElement>('[data-chapter]');
  const showChapter = (id: string, focus = false) => {
    const c = chapters.find((x) => x.id === id)!;
    stations.forEach((s) => {
      const on = s.dataset.chapter === id;
      s.setAttribute('aria-selected', String(on));
      s.tabIndex = on ? 0 : -1;
      if (on && focus) s.focus();
    });
    $('[data-c="code"]', card).textContent = c.code;
    $('[data-c="city"]', card).textContent = c.city;
    $('[data-c="since"]', card).textContent = `Sejak ${c.since}${c.hq ? ' · pusat' : ''}`;
    $('[data-c="members"]', card).textContent = String(c.members);
    $('[data-c="lead"]', card).textContent = c.lead;
    $('[data-c="kopdar"]', card).textContent = c.kopdar;
    card.classList.remove('flip');
    void card.offsetWidth;
    card.classList.add('flip');
  };
  stations.forEach((s, i) => {
    s.addEventListener('click', () => showChapter(s.dataset.chapter!));
    s.addEventListener('keydown', (e) => {
      const k = e.key;
      if (!['ArrowRight', 'ArrowLeft', 'ArrowDown', 'ArrowUp'].includes(k)) return;
      e.preventDefault();
      const n = (i + (k === 'ArrowRight' || k === 'ArrowDown' ? 1 : -1) + stations.length) % stations.length;
      showChapter(stations[n].dataset.chapter!, true);
    });
  });
  showChapter('solo');

  /* ---------- Gallery lightbox ---------- */
  const lb = $<HTMLDialogElement>('[data-lightbox]');
  const lbImg = $<HTMLImageElement>('[data-lb-img]');
  let li = 0;
  const showShot = (i: number) => {
    li = (i + gallery.length) % gallery.length;
    const g = gallery[li];
    const h = g.tall ? 1.29 : 0.74;
    lbImg.src = photo(g.id, 1400, Math.round(1400 * h));
    lbImg.srcset = srcset(g.id, h, [800, 1400, 2000]);
    lbImg.sizes = '100vw';
    lbImg.alt = g.caption;
    lbImg.style.animation = 'none';
    void lbImg.offsetWidth;
    lbImg.style.animation = '';
    $('[data-lb-cap]').textContent = g.caption;
    $('[data-lb-count]').textContent = `${li + 1} / ${gallery.length}`;
  };
  $$<HTMLButtonElement>('[data-shot]').forEach((b) =>
    b.addEventListener('click', () => {
      showShot(Number(b.dataset.shot));
      lb.showModal();
    }),
  );
  $('[data-lb-prev]').addEventListener('click', () => showShot(li - 1));
  $('[data-lb-next]').addEventListener('click', () => showShot(li + 1));
  $('[data-lb-close]').addEventListener('click', () => lb.close());
  lb.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') showShot(li + 1);
    if (e.key === 'ArrowLeft') showShot(li - 1);
  });
  let touchX = 0;
  lb.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
  lb.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 50) showShot(li + (dx < 0 ? 1 : -1));
  });

  /* ---------- Merch sizes ---------- */
  $$('[data-product]').forEach((p) => {
    const buy = $<HTMLAnchorElement>('[data-buy]', p);
    $$<HTMLButtonElement>('[data-size]', p).forEach((s, _, all) =>
      s.addEventListener('click', () => {
        all.forEach((x) => x.setAttribute('aria-checked', String(x === s)));
        buy.href = wa(`Halo ${club.short}, saya mau pesan ${buy.dataset.buy} ukuran ${s.dataset.size} (${rupiah(Number(buy.dataset.price))}).`);
      }),
    );
  });

  /* ---------- Join form + live member card ---------- */
  const form = $<HTMLFormElement>('[data-join]');
  const kta = $('[data-kta]');
  const f = {
    name: $<HTMLInputElement>('#j-name'),
    nick: $<HTMLInputElement>('#j-nick'),
    plate: $<HTMLInputElement>('#j-plate'),
    bike: $<HTMLInputElement>('#j-bike'),
    chapter: $<HTMLSelectElement>('#j-chapter'),
    sim: $<HTMLInputElement>('#j-sim'),
    rules: $<HTMLInputElement>('#j-rules'),
  };
  const nextNo = chapters.reduce((s, c) => s + c.members, 0) + 1;
  /** "ad1234xy" -> "AD 1234 XY" (region letters, numbers, suffix). */
  const fmtPlate = (v: string) => {
    const m = v.toUpperCase().replace(/[^A-Z0-9]/g, '').match(/^([A-Z]{0,2})(\d{0,4})([A-Z]{0,3})/);
    return m ? [m[1], m[2], m[3]].filter(Boolean).join(' ') : '';
  };
  const k = (key: string) => $(`[data-k="${key}"]`, kta);
  let bumpT = 0;
  const paint = () => {
    const name = f.name.value.trim();
    const ch = chapters.find((c) => c.id === f.chapter.value)!;
    k('name').textContent = name || 'Nama kamu';
    k('nick').textContent = f.nick.value.trim() ? `"${f.nick.value.trim()}"` : '"panggilan"';
    k('bike').textContent = f.bike.value.trim() || '—';
    k('plate').textContent = f.plate.value || `${ch.code} ···· ··`;
    k('chapter').textContent = ch.city;
    k('blood').textContent = $<HTMLInputElement>('input[name="blood"]:checked', form).value;
    k('no').textContent = `${club.abbr}/${ch.code}/${String(nextNo).padStart(4, '0')}`;
    k('ini').textContent =
      name
        .split(/\s+/)
        .filter(Boolean)
        .map((w) => w[0])
        .slice(0, 2)
        .join('')
        .toUpperCase() || '?';
    clearTimeout(bumpT);
    kta.classList.remove('bump');
    bumpT = window.setTimeout(() => kta.classList.add('bump'), 10);
  };
  f.plate.addEventListener('input', () => {
    const pos = f.plate.value.length;
    f.plate.value = fmtPlate(f.plate.value);
    if (pos >= f.plate.value.length) f.plate.setSelectionRange(f.plate.value.length, f.plate.value.length);
  });
  form.addEventListener('input', paint);
  form.addEventListener('change', paint);
  paint();

  // Tilt + glare on the card (mouse only).
  const wrap = $('.jt-kta-wrap');
  if (!reduce && matchMedia('(hover: hover)').matches) {
    wrap.addEventListener('pointermove', (e) => {
      const r = kta.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width;
      const y = (e.clientY - r.top) / r.height;
      kta.classList.add('is-tilting');
      kta.style.setProperty('--ry', `${(x - 0.5) * 16}deg`);
      kta.style.setProperty('--rx', `${(0.5 - y) * 12}deg`);
      kta.style.setProperty('--gx', `${x * 100}%`);
      kta.style.setProperty('--gy', `${y * 100}%`);
    });
    wrap.addEventListener('pointerleave', () => {
      kta.classList.remove('is-tilting');
      kta.style.setProperty('--ry', '0deg');
      kta.style.setProperty('--rx', '0deg');
    });
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const checks: [HTMLInputElement, boolean, string][] = [
      [f.name, f.name.value.trim().length >= 3, 'Isi nama lengkap.'],
      [f.plate, /^[A-Z]{1,2} \d{1,4}( [A-Z]{1,3})?$/.test(f.plate.value), 'Plat nomor belum lengkap, contoh: AD 1234 XY.'],
      [f.bike, f.bike.value.trim().length >= 3, 'Tulis merek dan tipe motor.'],
      [f.sim, f.sim.checked, 'Centang SIM C dan STNK.'],
      [f.rules, f.rules.checked, 'Centang persetujuan pegangan klub.'],
    ];
    checks.forEach(([el, ok]) => el.setAttribute('aria-invalid', String(!ok)));
    const bad = checks.filter(([, ok]) => !ok);
    const err = $('[data-join-error]');
    err.hidden = bad.length === 0;
    err.textContent = bad.map(([, , m]) => m).join(' ');
    if (bad.length) {
      bad[0][0].focus();
      return;
    }
    const ch = chapters.find((c) => c.id === f.chapter.value)!;
    const text = [
      `Halo ${club.short}, saya mau daftar jadi anggota (dari website):`,
      '',
      `Nama: ${f.name.value.trim()}`,
      f.nick.value.trim() ? `Panggilan: ${f.nick.value.trim()}` : '',
      `Motor: ${f.bike.value.trim()}`,
      `Plat: ${f.plate.value}`,
      `Chapter: ${ch.city}`,
      `Gol. darah: ${$<HTMLInputElement>('input[name="blood"]:checked', form).value}`,
      'SIM C & STNK: aktif',
      '',
      'Saya setuju dengan empat pegangan klub.',
    ]
      .filter((l, i, a) => l !== '' || a[i - 1] !== '')
      .join('\n');
    window.open(wa(text), '_blank', 'noopener');
  });

  /* ---------- Reveal + counters + nav highlight ---------- */
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const t = e.target as HTMLElement;
        t.classList.add('is-in');
        const n = t.querySelector<HTMLElement>('[data-count]');
        if (n) countUp(n);
        io.unobserve(t);
      }),
    { rootMargin: '0px 0px -10% 0px' },
  );
  $$('[data-reveal], .jt-event').forEach((el) => io.observe(el));

  const navLinks = $$('[data-nav]');
  const spy = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) navLinks.forEach((a) => a.classList.toggle('is-active', a.dataset.nav === e.target.id));
      }),
    { rootMargin: '-45% 0px -50% 0px' },
  );
  navLinks.forEach((a) => {
    const s = document.getElementById(a.dataset.nav!);
    if (s) spy.observe(s);
  });
</script>
