  .jt-hq { font-family: var(--f-stencil); font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; padding: 0.1rem 0.35rem; border: 1.5px solid var(--ink); border-radius: 3px; }
  .jt-chapter-card { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem 2rem; padding: 1.5rem; background: #fff; border: 3px solid var(--ink); border-radius: 10px; box-shadow: 8px 8px 0 var(--ink); }
