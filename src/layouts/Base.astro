---
import '@fontsource-variable/inter';
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import { url, PORTFOLIO } from '../lib/util';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  themeColor?: string;
  /** Hide the demo notice bar (used on the demo index page). */
  bare?: boolean;
  /** Keep search engines away (default). Set false for real pages like the pricelist. */
  noindex?: boolean;
}

const { title, description, bodyClass = '', themeColor = '#0f172a', bare = false, noindex = true } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  </head>
  <body class={bodyClass}>
    {
      !bare && (
        <div class="relative z-50 bg-slate-950 px-4 py-2 text-center font-sans text-xs text-slate-300">
          <span class="mr-1 rounded bg-amber-400 px-1.5 py-0.5 font-semibold text-slate-950">DEMO</span>
          Bisnis fiktif untuk contoh portofolio, dibuat oleh{' '}
          <a href={PORTFOLIO} class="font-medium text-white underline-offset-2 hover:underline">
            Purbo Panambang
          </a>
          .{' '}
          <a href={url('/')} class="font-medium text-amber-300 underline-offset-2 hover:underline">
            Lihat demo lain →
          </a>
        </div>
      )
    }
    <slot />
  </body>
</html>
